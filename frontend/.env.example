# Salin berkas ini menjadi .env lalu sesuaikan bila perlu.
# Berkas .env tidak ikut masuk git, lihat .gitignore pada root repositori.

# Alamat asal backend JakSafe. Dipakai oleh dev server Vite sebagai tujuan
# proxy untuk semua permintaan yang diawali /api. Harus sama dengan PORT
# yang dipakai backend pada berkas backend/.env, bawaannya 3001.
VITE_BACKEND_ORIGIN=http://localhost:3001

# Awalan jalur API yang dipakai kode frontend. Dibiarkan /api supaya cocok
# dengan aturan proxy di vite.config.js. Diubah hanya kalau backend nanti
# dipasang di domain terpisah tanpa proxy, misalnya https://api.jaksafe.id
VITE_API_BASE=/api
